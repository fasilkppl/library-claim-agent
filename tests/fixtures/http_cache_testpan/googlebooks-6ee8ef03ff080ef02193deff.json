eg mit der Gro\u00dfmutter und deren Bruder in ein verstecktes Alpental, den \u00bbHeimlichen Grund\u00ab, fliehen. Von der Au\u00dfenwelt abgeschnitten und nach dem Tod der Erwachsenen auf sich allein gestellt, vollziehen die beiden die Entwicklung der Menschheit von der Stein- \u00fcber die Bronze- bis zur Eisenzeit nach. Der Band enth\u00e4lt die drei Romane \u00bbDie H\u00f6hlenkinder \u2013 Im Heimlichen Grund\u00ab, \u00bbDie H\u00f6hlenkinder \u2013 Im Pfahlbau\u00ab und \u00bbDie H\u00f6hlenkinder \u2013 Im Steinhaus\u00ab.", "industryIdentifiers": [{"type": "ISBN_10", "identifier": "3959090498"}, {"type": "ISBN_13", "identifier": "9783959090490"}], "readingModes": {"text": false, "image": false}, "pageCount": 288, "printType": "BOOK", "categories": ["Fiction"], "maturityRating": "NOT_MATURE", "allowAnonLogging": false, "contentVersion": "preview-1.0.0", "panelizationSummary": {"containsEpubBubbles": false, "containsImageBubbles": false}, "imageLinks": {"smallThumbnail": "http://books.google.com/books/content?id=n2JrzgEACAAJ&printsec=frontcover&img=1&zoom=5&source=gbs_api", "thumbnail": "http://books.google.com/books/content?id=n2JrzgEACAAJ&printsec=frontcover&img=1&zoom=1&source=gbs_api"}, "language": "de", "previewLink": "http://books.google.co.in/books?id=n2JrzgEACAAJ&dq=intitle:Die+H%C3%B6hlenkinder&hl=&as_pt=BOOKS&cd=7&source=gbs_api", "infoLink": "http://books.google.co.in/books?id=n2JrzgEACAAJ&dq=intitle:Die+H%C3%B6hlenkinder&hl=&as_pt=BOOKS&source=gbs_api", "canonicalVolumeLink": "https://books.google.com/books/about/Die_H%C3%B6hlenkinder.html?hl=&id=n2JrzgEACAAJ"}, "saleInfo": {"country": "IN", "saleability": "NOT_FOR_SALE", "isEbook": false}, "accessInfo": {"country": "IN", "viewability": "NO_PAGES", "embeddable": false, "publicDomain": false, "textToSpeechPermission": "ALLOWED", "epub": {"isAvailable": false}, "pdf": {"isAvailable": false}, "webReaderLink": "http://play.google.com/books/reader?id=n2JrzgEACAAJ&hl=&as_pt=BOOKS&source=gbs_api", "acce