on": "288", "publish_date": "1999", "publishers": ["O'Reilly Media, Incorporated"], "source_records": ["bwb:9781565928756"], "subjects": ["Linux (computer operating system)", "Open source software"], "title": "Cathedral and the Bazaar", "subtitle": "Musings on Linux and Open Source by an Accidental Revolutionary", "full_title": "Cathedral and the Bazaar Musings on Linux and Open Source by an Accidental Revolutionary", "works": [{"key": "/works/OL6036025W"}], "key": "/books/OL36776874M", "latest_revision": 3, "revision": 3, "created": {"type": "/type/datetime", "value": "2022-01-27T20:53:25.543887"}, "last_modified": {"type": "/type/datetime", "value": "2025-05-01T02:41:04.746147"}}, {"type": {"key": "/type/edition"}, "authors": [{"key": "/authors/OL1517703A"}], "isbn_13": ["9780596553968"], "languages": [{"key": "/languages/eng"}], "lc_classifications": ["QA76.76.O6; QA76.76"], "pagination": "258", "publish_date": "2001", "publishers": ["O'Reilly Media, Incorporated"], "source_records": ["bwb:9780596553968"], "subjects": ["Linux (computer operating system)", "Open source software"], "title": "Cathedral and the Bazaar", "subtitle": "Musings on Linux and Open Source by an Accidental Revolutionary", "full_title": "Cathedral and the Bazaar Musings on Linux and Open Source by an Accidental Revolutionary", "works": [{"key": "/works/OL6036025W"}], "key": "/books/OL36801979M", "latest_revision": 3, "revision": 3, "created": {"type": "/type/datetime", "value": "2022-01-28T03:43:37.802583"}, "last_modified": {"type": "/type/datetime", "value": "2025-05-01T02:41:04.746147"}}, {"works": [{"key": "/works/OL6036025W"}], "title": "La cattedrale e il bazar", "publishers": ["Apogeo"], "publish_date": "2022-11", "key": "/books/OL51162356M", "type": {"key": "/type/edition"}, "identifiers": {}, "covers": [14590181], "classifications": {}, "description": "Una lettura imprescindibile per chiunque si interessi di computer e software, del passato, presente e futuro del settore IT e dell'economia basata sull'informazione. Il \"manifesto\" di Eric S. Raymond racconta i retroscena e le pietre miliari della rivoluzione open source e spiega come sia stato possibile far diventare mainstream lo sviluppo collaborativo di software trasformandolo nel motore immobile di Internet e di societ\u00e0 e aziende che oggi controllano il Mondo. Le sue conclusioni sono ancora oggi materia di studio, riflessione e approfondimento.\r\nIl testo contiene i saggi La cattedrale e il bazaar, Colonizzare la noosfera, Il calderone magico, oltre a Breve storia sugli hacker, La rivincita degli hacker e Come diventare un hacker.", "physical_format": "Paperback", "number_of_pages": 208, "isbn_13": ["9788850336265"], "latest_revision": 4, "revision": 4, "created": {"type": "/type/datetime", "value": "2024-02-27T17:38:36.528795"}, "last_modified": {"type": "/type/datetime", "value": "2024-02-27T17:41:23.697459"}}, {"identifiers": {"librarything": ["28530"], "goodreads": ["33053"], "wikidata": ["Q104696067"]}, "title": "The Cathedral & the Bazaar ", "subtitle": "Musings on Linux and Open Source by an Accidental Revolutionary", "authors": [{"key": "/authors/OL1517703A"}, {"key": "/authors/OL291900A"}], "publish_date": "February 2001", "publishers": ["O'Reilly"], "covers": [388515], "isbn_13": ["9780596001315"], "source_records": ["ia:cathedralbazaarm00raym_598", "bwb:9780596001315"], "languages": [{"key": "/languages/eng"}], "isbn_10": ["0596001312"], "type": {"key": "/type/edition"}, "key": "/books/OL7580913M", "number_of_pages": 256, "works": [{"key": "/works/OL6036025W"}], "lc_classifications": ["QA76.76.O63R397 2001"], "latest_revision": 11, "revision": 11, "created": {"type": "/type/datetime", "value": "2008-04-29T13:35:46.876380"}, "last_modified": {"type": "/type/datetime", "value": "2025-03-28T15:32:19.263333"}}, {"other_titles": ["Cathedral and the bazaar"], "publishers": ["O'Reilly"], "number_of_pages": 268, "subtitle": "musings on Linux and open source by an accidental revolutionary", "ia_box_id": ["IA135509"], "links": [{"url": "http://www.loc.gov/catdir/enhancements/fy0915/99045768-b.html", "title": "Contributor biographical information"}, {"url": "http://www.loc.gov/catdir/enhancements/fy0915/99045768-d.html", "title": "Publisher description"}], "isbn_10": ["1565927249"], "ia_loaded_id": ["cathedralbazaarm00raym"], "lc_classifications": ["QA76.76.O63 R396 1999", "QA76.76.O63R396 1999", "QA76.76.O63 R396 1999eb"], "key": "/books/OL24961500M", "authors": [{"key": "/authors/OL1517703A"}], "publish_places": ["Beijing", "Cambridge, Mass"], "edition_name": "1st ed.", "pagination": "xi, 268 p. ;", "source_records": ["ia:cathedralbazaarm00raym", "marc:marc_loc_2016/BooksAll.2016.part28.utf8:12784873:1094", "bwb:9781565927247", "marc:marc_columbia/Columbia-extract-20221130-009.mrc:285634715:2919", "marc:harvard_bibliographic_metadata/20220215_009.bib.mrc:33713776:3211"], "title": "The cathedral & the bazaar", "lccn": ["99045768"], "notes": {"type": "/type/text", "value": "Includes bibliographical references."}, "identifiers": {"wikidata": ["Q58880399"]}, "full_title": "The cathedral & the bazaar musings on Linux and open source by an accidental revolutionary", "languages": [{"key": "/languages/eng"}], "dewey_decimal_class": ["005.4/32"], "subjects": ["Development", "Computer hackers", "Linux", "Operating systems (Computers)", "Computer software"], "publish_date": "1999", "publish_country": "cc ", "by_statement": "Eric S. Raymond, with a foreword by Bob Young", "works": [{"key": "/works/OL6036025W"}], "type": {"key": "/type/edition"}, "oclc_numbers": ["44957644", "42420737"], "description": {"type": "/type/text", "value": "\"The leading challenger to Microsoft's stranglehold on the computer industry is an operating system called Linux, the product of thousands of volunteer programmers who collaborate over the Internet. The software behind a majority of all the world's web sites doesn't come from a big company either, but from a loosely coordinated group of volunteer programmers called the Apache Group. The Internet itself, and much of its core software, was developed through a process of networked collaboration.\".\n\n\"The key to these successes is a movement that has come to be called open source, because it depends on the ability of programmers to freely share their program source code so that others can improve it. In 1997, Eric S. Raymond outlined the core principles of this movement in a manifesto called The Cathedral and the Bazaar, which was published and freely redistributed over the Internet.\"--BOOK JACKET."}, "latest_revision": 9, "revision": 9, "created": {"type": "/type/datetime", "value": "2011-08-11T18:07:32.472204"}, "last_modified": {"type": "/type/datetime", "value": "2025-06-10T10:45:53.809924"}}, {"publishers": ["O'Reilly Media, Incorporated"], "subtitle": "Musings on Linux and Open Source by an Accidental Revolutionary", "last_modified": {"type": "/type/datetime", "value": "2020-08-22T12:34:28.764413"}, "source_records": ["bwb:9780596804480"], "title": "Cathedral and the Bazaar", "number_of_pages": 258, "isbn_13": ["9780596804480"], "created": {"type": "/type/datetime", "value": "2020-08-22T12:34:28.764413"}, "languages": [{"key": "/languages/eng"}], "full_title": "Cathedral and the Bazaar Musings on Linux and Open Source by an Accidental Revolutionary", "lc_classifications": [""], "publish_date": "2001", "key": "/books/OL29139003M", "authors": [{"key": "/authors/OL1517703A"}], "latest_revision": 1, "works": [{"key": "/works/OL6036025W"}], "type": {"key": "/type/edition"}, "subjects": ["Linux (computer operating system)", "Open source software"], "revision": 1}, {"identifiers": {"goodreads": ["134825"], "librarything": ["28530"], "wikidata": ["Q104696067"]}, "title": "The Cathedral & the Bazaar", "subtitle": "Musings on Linux and Open Source by an Accidental Revolutionary", "authors": [{"key": "/authors/OL1517703A"}], "publish_date": "January 15, 2001", "publishers": ["O'Reilly Medi