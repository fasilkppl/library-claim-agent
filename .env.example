# Copy to .env and fill in. Empty keys disable that source: lines without a price are left blank,
# excluded from totals and listed in the review queue (never estimated).

# Google Shopping results via SerpAPI (new prices, item ranges). https://serpapi.com/manage-api-key
SERPAPI_API_KEY=
# Same Google Shopping results via Serper.dev (2500 free credits at sign-up, 2 per search).
# Used instead of SerpAPI when set. https://serper.dev/api-key
SERPER_API_KEY=
# eBay Browse API, production keyset (used prices). https://developer.ebay.com/my/keys
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
# Google Books (catalogue matching, book heights, ebook fallback). Free key; without it the shared
# anonymous quota is often exhausted. https://console.cloud.google.com/apis/library/books.googleapis.com
GOOGLE_BOOKS_API_KEY=

# Optional overrides (defaults shown)
# CLAIM_COUNTRY=IN
# CLAIM_CURRENCY=INR
# CLAIM_SECOND_COUNTRY=US
# CLAIM_LLM_MODEL=qwen3-vl:8b-instruct
# CLAIM_WHISPER_MODEL=large-v3-turbo
# CLAIM_WHISPER_DEVICE=mps
# CLAIM_APPRAISAL_THRESHOLD_USD=150
# CLAIM_OLLAMA_URL=http://127.0.0.1:11434
